<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- WebAuthn/passkeys: without this WKWebView never offers the platform
	     passkey sheet (navigator.credentials.get throws instead). -->
	<key>com.apple.web-browser.public-key-credential</key>
	<true/>
</dict>
</plist>
