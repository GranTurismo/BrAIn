<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe (not Exe): GUI subsystem on Windows, so no console window is
         allocated when the browser starts. stdio MCP still works — the client
         supplies pipes, which don't need a console. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>BrAIn</RootNamespace>
    <AssemblyName>BrAIn</AssemblyName>
    <!-- The updater compares this against the latest GitHub release tag — bump it
         together with scripts/make-dist.sh's version argument. -->
    <Version>1.0.4</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <!-- macOS bundle settings are applied when publishing for osx-* RIDs -->
    <RuntimeIdentifiers>win-x64;osx-arm64;osx-x64</RuntimeIdentifiers>
    <!-- High-Performance Runtime & Memory Optimization Settings -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
    <TieredPGO>true</TieredPGO>
    <TieredCompilation>true</TieredCompilation>
    <!-- Don't copy the WebView2 package's IntelliSense .xml files next to the build output. -->
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3719.77" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\brain.js" LogicalName="BrAIn.Assets.brain.js" />
    <EmbeddedResource Include="Assets\theme.css" LogicalName="BrAIn.Assets.theme.css" />
    <EmbeddedResource Include="Assets\newtab.html" LogicalName="BrAIn.Assets.newtab.html" />
    <EmbeddedResource Include="Assets\help.html" LogicalName="BrAIn.Assets.help.html" />
    <EmbeddedResource Include="Assets\shortcuts.html" LogicalName="BrAIn.Assets.shortcuts.html" />
    <EmbeddedResource Include="Assets\history.html" LogicalName="BrAIn.Assets.history.html" />
    <EmbeddedResource Include="Assets\import.html" LogicalName="BrAIn.Assets.import.html" />
    <EmbeddedResource Include="Assets\passwords.html" LogicalName="BrAIn.Assets.passwords.html" />
    <EmbeddedResource Include="Assets\flows.html" LogicalName="BrAIn.Assets.flows.html" />
    <EmbeddedResource Include="Assets\chrome.js" LogicalName="BrAIn.Assets.chrome.js" />
    <Content Include="Assets\icon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
